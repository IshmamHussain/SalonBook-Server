# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB (Native Driver — NO Mongoose)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/salonbook?retryWrites=true&w=majority
MONGODB_DB_NAME=salonbook

# Application URLs
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# Better Auth Configuration
BETTER_AUTH_SECRET=replace-with-a-32-char-random-secret-key
BETTER_AUTH_URL=http://localhost:5000

# Express JWT Secret (used alongside Better Auth JWKS verification)
JWT_SECRET=replace-with-a-separate-32-char-jwt-secret

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe Credentials
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ImgBB Image Hosting API Key
IMGBB_API_KEY=your_imgbb_api_key

# Seed Admin Credentials (used only by `npm run seed`)
SEED_ADMIN_NAME=SalonBook Admin
SEED_ADMIN_EMAIL=your-admin-email@example.com
SEED_ADMIN_PASSWORD=replace-with-strong-admin-password
